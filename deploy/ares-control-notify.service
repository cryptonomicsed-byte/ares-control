[Unit]
Description=ares-control Vantage notification heartbeat (30s poll -> webhook dispatch)
After=network.target vantage.service

[Service]
ExecStart=/opt/ares-control/venv/bin/python /opt/ares-control/service/vantage_notify_heartbeat.py
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/ares-control/service
EnvironmentFile=/opt/ares-control/.env
User=root
Nice=10

[Install]
WantedBy=multi-user.target
