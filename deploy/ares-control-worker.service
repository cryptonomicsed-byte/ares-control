[Unit]
Description=ares-control worker (executes systemctl actions, polls daemon status)
After=network.target ares-control-api.service

[Service]
ExecStart=/opt/ares-control/venv/bin/python /opt/ares-control/service/worker.py
Restart=on-failure
RestartSec=5
WorkingDirectory=/opt/ares-control/service
EnvironmentFile=/opt/ares-control/.env
User=root
Nice=10
# CPUQuota caps this process even under a scheduling storm -- it should
# never be able to contend meaningfully against the API or Vantage.
CPUQuota=20%

[Install]
WantedBy=multi-user.target
